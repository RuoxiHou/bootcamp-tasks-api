{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(http_requests_total{job=\"${service_name}\"}[24h]))",
          "legendFormat": "total http requests",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Total HTTP Requests (24h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(tasks_created_total{job=\"${service_name}\"}[24h]))",
          "legendFormat": "tasks created",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tasks Created (24h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "editorMode": "code",
          "expr": "tasks_total{job=\"${service_name}\"}",
          "legendFormat": "current tasks",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Current Tasks Total",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [
        {
          "editorMode": "code",
          "expr": "active_tasks_count{job=\"${service_name}\"}",
          "legendFormat": "active tasks",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Current Active Tasks",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (method) (increase(http_requests_total{job=\"${service_name}\"}[24h]))",
          "legendFormat": "{{method}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP Requests by Method (24h)",
      "type": "barchart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8},
      "id": 6,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (priority) (increase(tasks_created_total{job=\"${service_name}\"}[24h]))",
          "legendFormat": "{{priority}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tasks Created by Priority (24h)",
      "type": "barchart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${prometheus_uid}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 18},
      "id": 7,
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status) (tasks_by_status{job=\"${service_name}\"})",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tasks by Status",
      "type": "piechart"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["tasks-api", "business-kpi"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "title": "Tasks API Business KPIs",
  "uid": "tasks-api-business-kpis",
  "version": 1
}