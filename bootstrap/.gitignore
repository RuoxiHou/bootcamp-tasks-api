# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files (often contain secrets)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform CLI configuration files
.terraformrc
terraform.rc

# Terraform lock file
.terraform.lock.hcl

# Plan output files
*.tfplan
*.plan

# Sensitive environment files
.env
.env.*

# Editor files
.vscode/
.idea/
*.swp
*.swo
